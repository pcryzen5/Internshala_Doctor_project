# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Auth
AUTH_DISABLED=true
JWT_SECRET=supersecretdevkeyatleast32characterslong12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Database (SQLite default for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./clinical_transcription.db

# ASR (faster-whisper)
# Model options: tiny, base, small, small.en, medium, large-v3
WHISPER_MODEL=small.en
# Device options: cpu, cuda, auto
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# LLM Provider
# Options: mock, anthropic, openai
LLM_PROVIDER=mock
LLM_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Audio & Data Retention
MAX_AUDIO_SECONDS=30
RETENTION_DAYS=30
AUDIO_STORAGE_PATH=./audio_storage
